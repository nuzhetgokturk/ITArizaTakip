
@page "/giris"

@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components

@inject IAntiforgery Antiforgery
@inject NavigationManager Navigation

<PageTitle>Giriş Yap</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow p-4">

                <h3 class="text-center mb-3">IT ARIZA TAKİP SİSTEMİ</h3>
                <h5 class="text-center mb-4">Kullanıcı Girişi</h5>

                <form method="post" action="/account/login">
                    <AntiforgeryToken />

                    <div class="mb-3">
                        <label class="form-label">Giriş Türü</label>

                        <div class="form-check mb-2">
                            <input class="form-check-input"
                                   type="radio"
                                   name="Rol"
                                   value="Personel"
                                   checked />
                            <label class="form-check-label">
                                Personel Girişi
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="Rol"
                                   value="Yönetici" />
                            <label class="form-check-label">
                                Yönetici Girişi
                            </label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">E-posta</label>
                        <input class="form-control"
                               type="email"
                               name="Email"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Şifre</label>
                        <input class="form-control"
                               type="password"
                               name="Sifre"
                               required />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Giriş Yap
                    </button>
                </form>

                @if (Navigation.ToAbsoluteUri(Navigation.Uri)
                    .Query.Contains("hata=1"))
                {
                    <div class="alert alert-danger mt-3">
                        E-posta, şifre veya giriş türü hatalı!
                    </div>
                }

                <div class="text-center mt-3">
                    <a href="/kayit-ol">Personel Kayıt Ol</a>
                </div>

            </div>
        </div>
    </div>
</div>
