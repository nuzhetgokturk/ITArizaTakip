
@page "/database"
@using ITArizaTakip.Data
@inject DatabaseTest DatabaseTest

<PageTitle>Veritabanı Testi</PageTitle>

<h3>PostgreSQL Bağlantı Testi</h3>

<p>Veritabanı bağlantısını kontrol etmek için aşağıdaki butona tıkla.</p>

<button class="btn btn-primary" @onclick="TestConnection">
    Bağlantıyı Test Et
</button>

@if (!string.IsNullOrEmpty(message))
{
    <p class="mt-3">@message</p>
}

@code {
    private string message = "";

    private async Task TestConnection()
    {
        try
        {
            bool connected = await DatabaseTest.TestConnectionAsync();

            message = connected
                ? "PostgreSQL bağlantısı başarılı!"
                : "PostgreSQL bağlantısı kurulamadı.";
        }
        catch (Exception ex)
        {
            message = "Bağlantı hatası: " + ex.Message;
        }
    }
}
